pipeline {
    agent any

    tools {
        // 这里需要先在 Jenkins 全局工具配置里添加名为 'jdk21' 的 JDK
        jdk 'jdk21'
        // 这里需要先在 Jenkins 全局工具配置里添加名为 'maven3' 的 Maven
        maven 'maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                // 从代码仓库拉取代码，替换成你自己的仓库地址和凭据
                git branch: 'main',
                    url: 'https://github.com/jian0726/java_web_zhi_shi_ping_tai.git',
                    credentialsId: 'jhh'
            }
        }

        stage('Build with Maven') {
            steps {
                // 进入子目录 zhi_shi_ku 执行 Maven 打包
                dir('zhi_shi_ku') {
                    bat  'mvn -B package --file pom.xml'
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                // 归档构建产物，相当于 GitHub Actions 的 upload-artifact
                archiveArtifacts artifacts: 'zhi_shi_ku/target/*.jar', fingerprint: true
            }
        }
    }
}